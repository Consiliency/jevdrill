{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "anyOf": [
        {
          "const": "route",
          "type": "string"
        },
        {
          "const": "report",
          "type": "string"
        }
      ],
      "title": "Operation"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "operation",
    "producer",
    "project_id",
    "workspace_id"
  ],
  "title": "CommandScope",
  "type": "object"
}
