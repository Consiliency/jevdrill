{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "description_revision": {
      "minLength": 1,
      "title": "Description Revision",
      "type": "string"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    }
  },
  "required": [
    "content_hash",
    "description",
    "description_revision",
    "resource_id",
    "revision"
  ],
  "title": "DiscoveryDescription",
  "type": "object"
}
