{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "title": "Created At",
      "type": "string"
    },
    "execution_target_id": {
      "title": "Execution Target Id",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Extensions",
      "type": "object"
    },
    "harness_id": {
      "minLength": 1,
      "title": "Harness Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "operation": {
      "const": "discover",
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "execution_target_id",
    "extensions",
    "harness_id",
    "idempotency_key",
    "operation",
    "project_id",
    "request_id",
    "schema_version",
    "workspace_id"
  ],
  "title": "DiscoveryEnvelope",
  "type": "object"
}
