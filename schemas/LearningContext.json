{
  "$defs": {
    "DiscoveryRef": {
      "additionalProperties": false,
      "properties": {
        "discovery_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Discovery Id",
          "type": "string"
        },
        "trace_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Digest",
          "type": "string"
        },
        "work_objective_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Work Objective Id",
          "type": "string"
        }
      },
      "required": [
        "discovery_id",
        "trace_digest",
        "work_objective_id"
      ],
      "title": "DiscoveryRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "discovery_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_revision": {
      "minLength": 1,
      "title": "Environment Revision",
      "type": "string"
    },
    "evaluator_ref": {
      "minLength": 1,
      "title": "Evaluator Ref",
      "type": "string"
    },
    "isolation_revision": {
      "minLength": 1,
      "title": "Isolation Revision",
      "type": "string"
    },
    "local_analysis_enabled": {
      "title": "Local Analysis Enabled",
      "type": "boolean"
    },
    "routing_decision_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Routing Decision Id",
      "type": "string"
    },
    "rubric_revision": {
      "minLength": 1,
      "title": "Rubric Revision",
      "type": "string"
    },
    "share_user_wide": {
      "title": "Share User Wide",
      "type": "boolean"
    },
    "task_family": {
      "minLength": 1,
      "title": "Task Family",
      "type": "string"
    },
    "task_group": {
      "minLength": 1,
      "title": "Task Group",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "discovery_ref",
    "environment_revision",
    "evaluator_ref",
    "isolation_revision",
    "local_analysis_enabled",
    "routing_decision_id",
    "rubric_revision",
    "share_user_wide",
    "task_family",
    "task_group",
    "task_id"
  ],
  "title": "LearningContext",
  "type": "object"
}
