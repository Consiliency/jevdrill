{
  "$defs": {
    "AcceptanceRequirement": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evaluator_ref": {
          "title": "Evaluator Ref",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "const": "user",
              "type": "string"
            },
            {
              "const": "task_family",
              "type": "string"
            },
            {
              "const": "inferred",
              "type": "string"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "description",
        "evaluator_ref",
        "requirement_id",
        "source"
      ],
      "title": "AcceptanceRequirement",
      "type": "object"
    },
    "OptimizationObjective": {
      "additionalProperties": false,
      "properties": {
        "acceptance_requirements": {
          "items": {
            "$ref": "#/$defs/AcceptanceRequirement"
          },
          "title": "Acceptance Requirements",
          "type": "array"
        },
        "direction": {
          "anyOf": [
            {
              "const": "minimize",
              "type": "string"
            },
            {
              "const": "maximize",
              "type": "string"
            }
          ],
          "title": "Direction"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "routing_cost_basis": {
          "anyOf": [
            {
              "const": "raw",
              "type": "string"
            },
            {
              "const": "adjusted",
              "type": "string"
            }
          ],
          "title": "Routing Cost Basis"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "acceptance_requirements",
        "direction",
        "metric_id",
        "objective_id",
        "routing_cost_basis",
        "version"
      ],
      "title": "OptimizationObjective",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "anyOf": [
        {
          "const": "insufficient_evidence",
          "type": "string"
        },
        {
          "const": "non_comparable",
          "type": "string"
        },
        {
          "const": "observed",
          "type": "string"
        }
      ],
      "title": "Classification"
    },
    "group_ids": {
      "items": {
        "type": "string"
      },
      "title": "Group Ids",
      "type": "array"
    },
    "objective": {
      "$ref": "#/$defs/OptimizationObjective"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "classification",
    "group_ids",
    "objective",
    "reason"
  ],
  "title": "ObjectiveAssessment",
  "type": "object"
}
