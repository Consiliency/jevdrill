{
  "$defs": {
    "DiscoveryRef": {
      "additionalProperties": false,
      "properties": {
        "discovery_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Discovery Id",
          "type": "string"
        },
        "trace_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Digest",
          "type": "string"
        },
        "work_objective_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Work Objective Id",
          "type": "string"
        }
      },
      "required": [
        "discovery_id",
        "trace_digest",
        "work_objective_id"
      ],
      "title": "DiscoveryRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "discovery_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Run Id"
    },
    "origin": {
      "anyOf": [
        {
          "const": "local",
          "type": "string"
        },
        {
          "const": "user_wide_redacted",
          "type": "string"
        }
      ],
      "title": "Origin"
    },
    "routing_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Routing Decision Id"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Task Id"
    }
  },
  "required": [
    "discovery_ref",
    "execution_run_id",
    "origin",
    "routing_decision_id",
    "task_id"
  ],
  "title": "ObservationSource",
  "type": "object"
}
