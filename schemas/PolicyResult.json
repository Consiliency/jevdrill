    "PolicyCaseAssignment": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "related_group": {
          "title": "Related Group",
          "type": "string"
        },
        "split": {
          "anyOf": [
            {
              "const": "policy_holdout",
              "type": "string"
            },
            {
              "const": "policy_regression",
              "type": "string"
            }
          ],
          "title": "Split"
