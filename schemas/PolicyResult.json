        "baseline_policy_revision",
        "calibration",
        "candidate_order",
        "cases",
        "minimum_improvement",
        "objective",
        "objective_value_ceiling",
        "policy_revision",
        "schema_version",
        "task_group"
      ],
      "title": "PolicyDefinition",
      "type": "object"
    },
