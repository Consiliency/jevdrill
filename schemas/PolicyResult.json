        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_family": {
          "anyOf": [
            {
              "const": "implementation",
              "type": "string"
            },
            {
              "const": "review",
              "type": "string"
            },
            {
              "const": "documentation",
              "type": "string"
            }
          ],
          "title": "Task Family"
        }
      },
      "required": [
        "calibration",
        "cases",
        "dataset_revision",
        "evaluator_ref",
        "evidence_origin",
        "identities_blinded",
        "rubric_revision",
        "schema_version",
        "task_family"
