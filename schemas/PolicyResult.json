        "cases": {
          "items": {
            "$ref": "#/$defs/PolicyCaseAssignment"
          },
          "maxItems": 100000,
          "minItems": 4,
          "title": "Cases",
          "type": "array"
        },
        "minimum_improvement": {
          "exclusiveMinimum": 0,
          "title": "Minimum Improvement",
          "type": "number"
        },
        "objective": {
          "$ref": "#/$defs/OptimizationObjective"
        },
        "objective_value_ceiling": {
          "exclusiveMinimum": 0,
          "title": "Objective Value Ceiling",
          "type": "number"
        },
        "policy_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Policy Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Group",
          "type": "string"
        }
