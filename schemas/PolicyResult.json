      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evaluator_ref": {
          "title": "Evaluator Ref",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "const": "user",
              "type": "string"
            },
            {
              "const": "task_family",
              "type": "string"
            },
            {
              "const": "inferred",
              "type": "string"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "description",
        "evaluator_ref",
        "requirement_id",
        "source"
      ],
      "title": "AcceptanceRequirement",
      "type": "object"
    },
    "CommandScope": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "anyOf": [
            {
              "const": "route",
              "type": "string"
            },
            {
              "const": "report",
              "type": "string"
            }
          ],
          "title": "Operation"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "producer",
        "project_id",
        "workspace_id"
      ],
      "title": "CommandScope",
      "type": "object"
    },
    "KnownMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "known",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "unit",
        "value"
      ],
      "title": "KnownMeasurement",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "counting_semantics": {
          "anyOf": [
            {
              "const": "disjoint",
              "type": "string"
            },
            {
              "const": "subset",
              "type": "string"
            },
            {
              "const": "not_applicable",
              "type": "string"
            }
          ],
