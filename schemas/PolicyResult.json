        },
        "candidate_critical": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Candidate Critical",
          "type": "object"
        },
        "candidate_measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Candidate Measurements",
          "type": "array"
        },
        "candidate_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "maximum": 1,
          "minimum": 0,
          "title": "Candidate Quality"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "exposed_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Exposed At",
          "type": "string"
        },
        "related_group": {
          "title": "Related Group",
          "type": "string"
        },
        "split": {
          "anyOf": [
            {
              "const": "development",
