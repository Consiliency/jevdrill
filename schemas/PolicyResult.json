        "task_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "related_group",
        "split",
        "task_id"
      ],
