        },
        "measurement_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnownMeasurement"
            },
            {
              "$ref": "#/$defs/UnknownMeasurement"
            }
          ],
          "title": "Measurement Value"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "parent_metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Metric Id"
        },
        "scope": {
          "anyOf": [
            {
              "const": "call",
              "type": "string"
            },
            {
              "const": "run",
              "type": "string"
            },
            {
              "const": "task",
              "type": "string"
            },
            {
              "const": "experiment",
              "type": "string"
            }
          ],
          "title": "Scope"
        },
        "source": {
          "anyOf": [
            {
              "const": "direct",
              "type": "string"
            },
            {
              "const": "provider",
              "type": "string"
            },
            {
              "const": "host",
              "type": "string"
            },
            {
              "const": "evaluator",
              "type": "string"
            },
            {
              "const": "estimate",
              "type": "string"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "counting_semantics",
        "measurement_value",
        "method",
        "metric_id",
        "metric_version",
        "parent_metric_id",
        "scope",
        "source"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "unsupported",
        "not_reported",
        "not_applicable",
        "redacted",
        "expired",
        "incomplete"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "OptimizationObjective": {
      "additionalProperties": false,
      "properties": {
        "acceptance_requirements": {
          "items": {
            "$ref": "#/$defs/AcceptanceRequirement"
          },
          "title": "Acceptance Requirements",
          "type": "array"
        },
        "direction": {
          "anyOf": [
            {
              "const": "minimize",
              "type": "string"
            },
            {
              "const": "maximize",
              "type": "string"
            }
          ],
          "title": "Direction"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "routing_cost_basis": {
          "anyOf": [
            {
              "const": "raw",
              "type": "string"
            },
            {
              "const": "adjusted",
              "type": "string"
            }
          ],
          "title": "Routing Cost Basis"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "acceptance_requirements",
        "direction",
        "metric_id",
        "objective_id",
        "routing_cost_basis",
        "version"
      ],
      "title": "OptimizationObjective",
      "type": "object"
    },
    "PolicyAssessment": {
      "additionalProperties": false,
      "properties": {
        "calibration_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Revision"
        },
        "candidate_quality_lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Quality Lower Bound"
        },
        "classification": {
          "anyOf": [
            {
              "const": "quality_gate_passed",
              "type": "string"
            },
            {
              "const": "critical_regression",
              "type": "string"
            },
            {
              "const": "quality_regression",
              "type": "string"
            },
            {
              "const": "insufficient_evidence",
              "type": "string"
            },
            {
              "const": "non_comparable",
              "type": "string"
            }
          ],
          "title": "Classification"
        },
        "critical_regressions": {
          "items": {
            "type": "string"
          },
          "title": "Critical Regressions",
          "type": "array"
        },
        "evidence_digest": {
          "title": "Evidence Digest",
          "type": "string"
        },
        "pair_count": {
          "title": "Pair Count",
          "type": "integer"
        },
        "promotion_authorized": {
          "const": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        },
        "quality_loss_upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Loss Upper Bound"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "calibration_revision",
        "candidate_quality_lower_bound",
        "classification",
        "critical_regressions",
        "evidence_digest",
        "pair_count",
        "promotion_authorized",
        "quality_loss_upper_bound",
        "reasons",
        "schema_version"
      ],
      "title": "PolicyAssessment",
      "type": "object"
    },
    "PolicyAuthorization": {
      "additionalProperties": false,
      "properties": {
        "allowed_policy_revisions": {
          "items": {
            "type": "string"
          },
