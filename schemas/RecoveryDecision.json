        "counting_semantics",
        "measurement_value",
        "method",
        "metric_id",
        "metric_version",
        "parent_metric_id",
        "scope",
        "source"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "unsupported",
        "not_reported",
        "not_applicable",
        "redacted",
        "expired",
        "incomplete"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "NeedsContext": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/DecisionDetails"
        },
        "missing_facts": {
          "items": {
            "type": "string"
          },
          "title": "Missing Facts",
          "type": "array"
        },
        "status": {
          "const": "needs_context",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "details",
        "missing_facts",
        "status"
      ],
      "title": "NeedsContext",
      "type": "object"
    },
    "NoCompatiblePlan": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/DecisionDetails"
        },
        "status": {
          "const": "no_compatible_plan",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "details",
        "status"
      ],
      "title": "NoCompatiblePlan",
      "type": "object"
    },
    "OptimizationObjective": {
      "additionalProperties": false,
      "properties": {
        "acceptance_requirements": {
          "items": {
            "$ref": "#/$defs/AcceptanceRequirement"
          },
          "title": "Acceptance Requirements",
          "type": "array"
        },
        "direction": {
          "anyOf": [
            {
              "const": "minimize",
              "type": "string"
            },
            {
              "const": "maximize",
              "type": "string"
            }
          ],
          "title": "Direction"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "routing_cost_basis": {
          "anyOf": [
            {
              "const": "raw",
              "type": "string"
            },
            {
              "const": "adjusted",
              "type": "string"
            }
          ],
          "title": "Routing Cost Basis"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "acceptance_requirements",
        "direction",
        "metric_id",
        "objective_id",
        "routing_cost_basis",
        "version"
      ],
      "title": "OptimizationObjective",
      "type": "object"
    },
    "ReadinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "checked_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Checked Capabilities",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "inventory_revision": {
          "title": "Inventory Revision",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Valid Until",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "checked_capabilities",
        "evidence_refs",
        "inventory_revision",
        "valid_until",
        "verified_at"
      ],
      "title": "ReadinessEvidence",
      "type": "object"
    },
    "Ready": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/DecisionDetails"
        },
        "execution_plan": {
          "$ref": "#/$defs/ExecutionPlan"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "readiness": {
          "$ref": "#/$defs/ReadinessEvidence"
        },
        "status": {
          "const": "ready",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "details",
        "execution_plan",
        "fallback_used",
        "readiness",
        "status"
      ],
      "title": "Ready",
      "type": "object"
    },
    "ReplayBundle": {
      "additionalProperties": false,
      "properties": {
        "cache_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Digest",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ready"
            },
            {
              "$ref": "#/$defs/NeedsContext"
            },
            {
              "$ref": "#/$defs/ConstraintConflict"
            },
            {
              "$ref": "#/$defs/NoCompatiblePlan"
            },
            {
              "$ref": "#/$defs/RoutingFailed"
            }
          ],
          "title": "Decision"
        },
        "judgments": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgmentRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "routing_decision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Routing Decision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "cache_digest",
        "decision",
        "judgments",
        "request_digest",
        "routing_decision_id",
        "schema_version",
        "task_id"
      ],
      "title": "ReplayBundle",
      "type": "object"
    },
    "RoutingFailed": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/DecisionDetails"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "status": {
          "const": "routing_failed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "details",
        "error_code",
        "retryable",
        "status"
      ],
      "title": "RoutingFailed",
      "type": "object"
    },
    "SetupProposal": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "missing_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Missing Capabilities",
          "type": "array"
        },
        "proposed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Actions",
          "type": "array"
        },
        "requires_authorization": {
          "title": "Requires Authorization",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "missing_capabilities",
        "proposed_actions",
        "requires_authorization"
      ],
      "title": "SetupProposal",
      "type": "object"
    },
    "UnknownMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/MissingReason"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "UnknownMeasurement",
      "type": "object"
    },
    "UnsupportedEffort": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unsupported",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UnsupportedEffort",
      "type": "object"
    },
    "VersionReferences": {
      "additionalProperties": false,
      "properties": {
        "catalog_revision": {
          "title": "Catalog Revision",
          "type": "string"
        },
        "context_revision": {
          "title": "Context Revision",
          "type": "string"
        },
        "evidence_revision": {
          "title": "Evidence Revision",
          "type": "string"
        },
        "policy_revision": {
          "title": "Policy Revision",
          "type": "string"
        },
        "settings_revision": {
          "title": "Settings Revision",
          "type": "string"
        }
      },
      "required": [
        "catalog_revision",
        "context_revision",
        "evidence_revision",
        "policy_revision",
        "settings_revision"
      ],
      "title": "VersionReferences",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "$ref": "#/$defs/ReplayBundle"
    },
    "scope": {
      "$ref": "#/$defs/CommandScope"
    }
  },
  "required": [
    "bundle",
    "scope"
  ],
  "title": "RecoveryDecision",
  "type": "object"
}
