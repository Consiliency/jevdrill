{
  "$defs": {
    "CommandScope": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "anyOf": [
            {
              "const": "route",
              "type": "string"
            },
            {
              "const": "report",
              "type": "string"
            }
          ],
          "title": "Operation"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "producer",
        "project_id",
        "workspace_id"
      ],
      "title": "CommandScope",
      "type": "object"
    },
    "DiscoveryGuidanceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "resource_id",
        "revision"
      ],
      "title": "DiscoveryGuidanceRef",
      "type": "object"
    },
    "DiscoveryRef": {
      "additionalProperties": false,
      "properties": {
        "discovery_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Discovery Id",
          "type": "string"
        },
        "trace_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trace Digest",
          "type": "string"
        },
        "work_objective_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Work Objective Id",
          "type": "string"
        }
      },
      "required": [
        "discovery_id",
        "trace_digest",
        "work_objective_id"
      ],
      "title": "DiscoveryRef",
      "type": "object"
    },
    "DiscoveryRevisions": {
      "additionalProperties": false,
      "properties": {
        "authorization_digest": {
          "title": "Authorization Digest",
          "type": "string"
        },
        "catalog_digest": {
          "title": "Catalog Digest",
          "type": "string"
        },
        "catalog_revision": {
          "title": "Catalog Revision",
          "type": "string"
        },
        "content_revision": {
          "title": "Content Revision",
          "type": "string"
        },
        "descriptions_digest": {
          "title": "Descriptions Digest",
          "type": "string"
        },
        "policy_digest": {
          "title": "Policy Digest",
          "type": "string"
        },
        "settings_revision": {
          "title": "Settings Revision",
          "type": "string"
        },
        "taxonomy_revision": {
          "title": "Taxonomy Revision",
          "type": "string"
        }
      },
      "required": [
        "authorization_digest",
        "catalog_digest",
        "catalog_revision",
        "content_revision",
        "descriptions_digest",
        "policy_digest",
        "settings_revision",
        "taxonomy_revision"
      ],
      "title": "DiscoveryRevisions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "discovery_ref": {
      "$ref": "#/$defs/DiscoveryRef"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "guidance_refs": {
      "items": {
        "$ref": "#/$defs/DiscoveryGuidanceRef"
      },
      "title": "Guidance Refs",
      "type": "array"
    },
    "revisions": {
      "$ref": "#/$defs/DiscoveryRevisions"
    },
    "scope": {
      "$ref": "#/$defs/CommandScope"
    },
    "status": {
      "anyOf": [
        {
          "const": "selected_guidance",
          "type": "string"
        },
        {
          "const": "no_optional_guidance",
          "type": "string"
        }
      ],
      "title": "Status"
    }
  },
  "required": [
    "discovery_ref",
    "domains",
    "guidance_refs",
    "revisions",
    "scope",
    "status"
  ],
  "title": "RecoveryDiscovery",
  "type": "object"
}
