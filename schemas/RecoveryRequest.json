{
  "$defs": {
    "CommandScope": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "anyOf": [
            {
              "const": "route",
              "type": "string"
            },
            {
              "const": "report",
              "type": "string"
            }
          ],
          "title": "Operation"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "producer",
        "project_id",
        "workspace_id"
      ],
      "title": "CommandScope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "const": "export",
          "type": "string"
        },
        {
          "const": "backup",
          "type": "string"
        },
        {
          "const": "import",
          "type": "string"
        },
        {
          "const": "restore",
          "type": "string"
        }
      ],
      "title": "Action"
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Id"
    },
    "encrypted_bundle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Encrypted Bundle"
    },
    "recovery_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recovery Key"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/CommandScope"
    }
  },
  "required": [
    "action",
    "artifact_id",
    "encrypted_bundle",
    "recovery_key",
    "schema_version",
    "scope"
  ],
  "title": "RecoveryRequest",
  "type": "object"
}
