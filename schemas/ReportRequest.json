{
  "$defs": {
    "EvaluationPayload": {
      "additionalProperties": false,
      "properties": {
        "check_results": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Check Results",
          "type": "object"
        },
        "evaluator_ref": {
          "title": "Evaluator Ref",
          "type": "string"
        },
        "kind": {
          "const": "evaluation",
          "title": "Kind",
          "type": "string"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "rubric_revision": {
          "title": "Rubric Revision",
          "type": "string"
        }
      },
      "required": [
        "check_results",
        "evaluator_ref",
        "kind",
        "measurements",
        "rubric_revision"
      ],
      "title": "EvaluationPayload",
      "type": "object"
    },
    "ExecutionEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Event Id",
          "type": "string"
        },
        "execution_run_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Execution Run Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecyclePayload"
            },
            {
              "$ref": "#/$defs/UsagePayload"
            },
            {
              "$ref": "#/$defs/EvaluationPayload"
            },
            {
              "$ref": "#/$defs/HostChoicePayload"
            }
          ],
          "title": "Payload"
        },
        "routing_decision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Routing Decision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_sequence": {
          "minimum": 0,
          "title": "Source Sequence",
          "type": "integer"
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Supersedes Event Id"
        },
        "task_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "execution_run_id",
        "occurred_at",
        "payload",
        "routing_decision_id",
        "schema_version",
        "source_id",
        "source_sequence",
        "supersedes_event_id",
        "task_id"
      ],
      "title": "ExecutionEvent",
      "type": "object"
    },
    "HostChoicePayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "host_choice",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "selected_run_id": {
          "title": "Selected Run Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "selected_run_id"
      ],
      "title": "HostChoicePayload",
      "type": "object"
    },
    "KnownMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "known",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "unit",
        "value"
      ],
      "title": "KnownMeasurement",
      "type": "object"
    },
    "LifecyclePayload": {
      "additionalProperties": false,
      "properties": {
        "applied_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applied Plan Id"
        },
        "event_type": {
          "anyOf": [
            {
              "const": "queued",
              "type": "string"
            },
            {
              "const": "started",
              "type": "string"
            },
            {
              "const": "plan_applied",
              "type": "string"
            },
            {
              "const": "completed",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "canceled",
              "type": "string"
            },
            {
              "const": "guidance_deactivated",
              "type": "string"
            }
          ],
          "title": "Event Type"
        },
        "kind": {
          "const": "lifecycle",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "applied_plan_id",
        "event_type",
        "kind",
        "reason"
      ],
      "title": "LifecyclePayload",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "counting_semantics": {
          "anyOf": [
            {
              "const": "disjoint",
              "type": "string"
            },
            {
              "const": "subset",
              "type": "string"
            },
            {
              "const": "not_applicable",
              "type": "string"
            }
          ],
          "title": "Counting Semantics"
        },
        "measurement_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnownMeasurement"
            },
            {
              "$ref": "#/$defs/UnknownMeasurement"
            }
          ],
          "title": "Measurement Value"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "parent_metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Metric Id"
        },
        "scope": {
          "anyOf": [
            {
              "const": "call",
              "type": "string"
            },
            {
              "const": "run",
              "type": "string"
            },
            {
              "const": "task",
              "type": "string"
            },
            {
              "const": "experiment",
              "type": "string"
            }
          ],
          "title": "Scope"
        },
        "source": {
          "anyOf": [
            {
              "const": "direct",
              "type": "string"
            },
            {
              "const": "provider",
              "type": "string"
            },
            {
              "const": "host",
              "type": "string"
            },
            {
              "const": "evaluator",
              "type": "string"
            },
            {
              "const": "estimate",
              "type": "string"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "counting_semantics",
        "measurement_value",
        "method",
        "metric_id",
        "metric_version",
        "parent_metric_id",
        "scope",
        "source"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "unsupported",
        "not_reported",
        "not_applicable",
        "redacted",
        "expired",
        "incomplete"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "RequestEnvelope": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "pattern": "Z$",
          "title": "Created At",
          "type": "string"
        },
        "execution_target_id": {
          "title": "Execution Target Id",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "harness_id": {
          "title": "Harness Id",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "const": "route",
              "type": "string"
            },
            {
              "const": "report",
              "type": "string"
            }
          ],
          "title": "Operation"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "execution_target_id",
        "extensions",
        "harness_id",
        "idempotency_key",
        "operation",
        "project_id",
        "request_id",
        "schema_version",
        "workspace_id"
      ],
      "title": "RequestEnvelope",
      "type": "object"
    },
    "UnknownMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/MissingReason"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "UnknownMeasurement",
      "type": "object"
    },
    "UsagePayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "usage",
          "title": "Kind",
          "type": "string"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "measurements"
      ],
      "title": "UsagePayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "#/$defs/RequestEnvelope"
    },
    "event": {
      "$ref": "#/$defs/ExecutionEvent"
    }
  },
  "required": [
    "envelope",
    "event"
  ],
  "title": "ReportRequest",
  "type": "object"
}
