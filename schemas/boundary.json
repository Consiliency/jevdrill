{
  "compiler_version": "0.20.1",
  "contracts": [
    "RouteRequest",
    "RoutingDecision",
    "ExecutionPlan",
    "ExecutionRun",
    "ReportRequest",
    "ReportAcknowledgment",
    "ExecutionEvent",
    "Measurement",
    "Settings",
    "ComparisonExperiment",
    "CapabilityMismatch",
    "LocalNotice"
  ],
  "event_transitions": {
    "canceled": [],
    "completed": [],
    "failed": [],
    "plan_applied": [
      "completed",
      "failed",
      "canceled"
    ],
    "queued": [
      "started",
      "failed",
      "canceled"
    ],
    "started": [
      "plan_applied",
      "completed",
      "failed",
      "canceled"
    ]
  },
  "experiment_transitions": {
    "accepted": [
      "queued",
      "running",
      "blocked",
      "canceled"
    ],
    "blocked": [
      "proposed"
    ],
    "canceled": [],
    "completed": [],
    "incomplete": [],
    "proposed": [
      "accepted",
      "blocked",
      "canceled"
    ],
    "queued": [
      "running",
      "blocked",
      "canceled"
    ],
    "running": [
      "completed",
      "incomplete",
      "canceled",
      "blocked"
    ]
  },
  "field_rules": {
    "ComparisonExperiment.assignment_probabilities": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      }
    },
    "ComparisonExperiment.candidate_plans": {
      "minItems": 2
    },
    "ExecutionEvent.source_sequence": {
      "minimum": 0
    },
    "ExecutionPlan.optional_guidance": {
      "maxItems": 2
    },
    "ExperimentLimits.cpu_limit": {
      "minimum": 1
    },
    "ExperimentLimits.max_candidates": {
      "minimum": 2
    },
    "ExperimentLimits.max_concurrency": {
      "minimum": 1
    },
    "ExperimentLimits.max_duration_ms": {
      "minimum": 1
    },
    "ExperimentLimits.memory_limit_bytes": {
      "minimum": 1
    },
    "HardConstraints.context_token_limit": {
      "minimum": 1
    },
    "HardConstraints.max_attempts": {
      "minimum": 1
    },
    "HardConstraints.total_deadline_ms": {
      "minimum": 1
    },
    "Money.amount": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "Money.currency": {
      "pattern": "^[A-Z]{3}$"
    },
    "RequestEnvelope.extensions": {
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$"
      }
    },
    "RetryContext.remaining_attempts": {
      "minimum": 0
    },
    "RetryContext.remaining_time_ms": {
      "minimum": 0
    },
    "Settings.routing_deadline_ms": {
      "minimum": 1
    }
  },
  "identities": [
    "RequestEnvelope.request_id",
    "RequestEnvelope.project_id",
    "RequestEnvelope.workspace_id",
    "ExecutionPlan.execution_plan_id",
    "ExecutionPlan.predecessor_plan_id",
    "RouteRequest.task_id",
    "RetryContext.prior_routing_decision_id",
    "RetryContext.prior_execution_run_id",
    "DecisionDetails.routing_decision_id",
    "DecisionDetails.request_id",
    "DecisionDetails.task_id",
    "DecisionDetails.reused_decision_id",
    "ExecutionRun.execution_run_id",
    "ExecutionRun.task_id",
    "ExecutionRun.selected_plan_id",
    "ExecutionRun.applied_plan_id",
    "ExecutionRun.prior_execution_run_id",
    "ExecutionEvent.event_id",
    "ExecutionEvent.task_id",
    "ExecutionEvent.routing_decision_id",
    "ExecutionEvent.execution_run_id",
    "ExecutionEvent.supersedes_event_id",
    "ComparisonExperiment.comparison_experiment_id",
    "ComparisonExperiment.task_id",
    "LocalNotice.notice_id"
  ],
  "omittable": {},
  "schema_version": 1,
  "semantic_validators": [
    "request_operation",
    "effective_capabilities",
    "guidance_consistency",
    "measurement_subset",
    "experiment_authority",
    "event_correction"
  ],
  "timestamps": [
    "RequestEnvelope.created_at",
    "DecisionDetails.created_at",
    "Capabilities.verified_at",
    "Capabilities.expires_at",
    "ReadinessEvidence.verified_at",
    "ReadinessEvidence.valid_until",
    "ExecutionEvent.occurred_at",
    "LocalNotice.deadline"
  ]
}
